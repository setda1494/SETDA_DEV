generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  SYSTEM
  USER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  displayName  String
  passwordHash String?
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  saves        GameSave[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GameSave {
  id        String   @id @default(cuid())
  userId    String
  gameKey   String
  slot      String   @default("default")
  version   Int      @default(1)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameKey, slot])
  @@index([gameKey])
}

enum ContentKind {
  PROJECT
  RELEASE
  MEDIA
  WEB_GAME
}

model ContentEntry {
  id        String      @id @default(cuid())
  kind      ContentKind
  key       String
  title     String
  data      Json
  published Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  auditLogs AuditLog[]

  @@unique([kind, key])
  @@index([kind, published])
}

model AuditLog {
  id          String        @id @default(cuid())
  actorId     String
  action      String
  contentId   String?
  contentKind ContentKind?
  contentKey  String?
  before      Json?
  after       Json?
  createdAt   DateTime      @default(now())
  actor       User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  content     ContentEntry? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([contentId])
}
